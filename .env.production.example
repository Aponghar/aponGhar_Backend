# Production Environment Configuration for Railway / Cloud
# Node Environment
NODE_ENV=production
PORT=5000

# Database Configuration (Railway MySQL or external URL)
# If using a single connection string:
# DATABASE_URL=mysql://root:${RAILWAY_MYSQL_PASSWORD}@homas.proxy.r1wy.net:52858/railway
DB_HOST=homas.proxy.r1wy.net
DB_PORT=52858
DB_NAME=railway
DB_USER=root
DB_PASSWORD=${RAILWAY_MYSQL_PASSWORD}
DB_CONNECTION_LIMIT=40

# JWT Secret - Generate a strong random 32+ character secret for production
# Command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=${JWT_SECRET_PRODUCTION}

# Razorpay Configuration (Live Keys)
RAZORPAY_KEY_ID=${RAZORPAY_LIVE_KEY_ID}
RAZORPAY_KEY_SECRET=${RAZORPAY_LIVE_SECRET}
# Webhook secret configured in Razorpay Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=${RAZORPAY_WEBHOOK_SECRET}

# Email Service Configuration (Resend)
# Obtain your API key from https://resend.com (format: re_...)
RESEND_API_KEY=${RESEND_API_KEY}
EMAIL_FROM=AponGhar <noreply@aponghar.in>

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=${CLOUDINARY_NAME}
CLOUDINARY_API_KEY=${CLOUDINARY_KEY}
CLOUDINARY_API_SECRET=${CLOUDINARY_SECRET}

# Google OAuth Configuration
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}

# Frontend Base URL
FRONTEND_URL=https://aponghar.in

# Allowed Origins (CORS)
ALLOWED_ORIGINS=https://aponghar.in,https://www.aponghar.in,https://api.aponghar.in

# Global Rate Limiting (Requests per 15 minutes per IP)
RATE_LIMIT_MAX=1000
